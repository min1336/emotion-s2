{
  "scripts": {
    "check": "npm run lint && npm test && npm run check:functions && npm run build",
    "check:functions": "deno check --config supabase/functions/send-poke/deno.json supabase/functions/send-poke/index.ts",
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint src --max-warnings=0",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
